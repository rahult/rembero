{
  "name": "rembero",
  "version": "0.32.0",
  "description": "Logic-based memory for LLM chats and agents: deterministic Datalog rules, explicit entity identity, integrity, provenance, graphs, and MCP",
  "type": "module",
  "bin": {
    "rembero": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "native",
    "docs/EVALS.md",
    "docs/EXPLAINABLE-KNOWLEDGE-GRAPH.md",
    "docs/STRATIFIED-NEGATION.md",
