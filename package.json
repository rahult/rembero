    "docs/MIGRATING-0.31.md",
    "docs/MIGRATING-0.32.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:sqlite": "sh native/build.sh",
    "pretest": "npm run build",
    "pretest:sqlite": "npm run build",
    "test": "vitest run",
    "test:sqlite": "vitest run tests/sqlite-extension.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "eval:recall": "npm run build && node dist/evals/run-recall.js",
    "bench:engine": "npm run build && node dist/evals/run-engine-benchmark.js",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahult/rembero.git"
  },
  "keywords": [
    "memory",
    "datalog",
    "prolog",
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "claude",
    "knowledge-base",
    "reasoning"
  ],
  "author": "Rahul Trikha",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
