    "docs/WHY-NOT-EXPLANATIONS.md",
    "docs/KNOWLEDGE-TOPOLOGY.md",
    "docs/RECORDED-KNOWLEDGE-DIFF.md",
    "docs/REPAIR-PLANNING.md",
    "docs/RULE-AUDIT.md",
    "docs/GROUNDED-NEGATIVE-RECALL.md",
    "docs/DETERMINISTIC-ANSWER-MODE.md",
    "docs/LOCAL-KNOWLEDGE-SEARCH.md",
    "docs/EXPLICIT-GRAPH-BROWSE.md",
    "docs/ARITHMETIC-COMPARISONS.md",
    "docs/AUTO-CAPTURE.md",
