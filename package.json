{
  "name": "rembero",
  "version": "0.8.0",
  "description": "Logic-based memory for LLM chats and agents: Datalog facts + rules with deterministic inference, an MCP server, and an LLM natural-language pipeline",
  "type": "module",
  "bin": {
    "rembero": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "native",
    "docs/EVALS.md",
    "docs/EXPLAINABLE-KNOWLEDGE-GRAPH.md",
    "docs/STRATIFIED-NEGATION.md",
    "docs/QUERY-AGGREGATION.md",
    "docs/ARITHMETIC-COMPARISONS.md",
    "docs/AUTO-CAPTURE.md",
    "docs/TEMPORAL-HISTORY.md",
    "docs/RECALL-SCHEMA-PRUNING.md",
    "docs/ALTERNATIVE-PROOFS.md",
    "docs/MIGRATING-0.2.md",
    "docs/MIGRATING-0.3.md",
    "docs/MIGRATING-0.4.md",
    "docs/MIGRATING-0.5.md",
    "docs/MIGRATING-0.6.md",
    "docs/MIGRATING-0.7.md",
    "docs/MIGRATING-0.8.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:sqlite": "sh native/build.sh",
    "pretest": "npm run build",
    "pretest:sqlite": "npm run build",
    "test": "vitest run",
    "test:sqlite": "vitest run tests/sqlite-extension.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "eval:recall": "npm run build && node dist/evals/run-recall.js",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahult/rembero.git"
  },
  "keywords": [
    "memory",
    "datalog",
    "prolog",
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "claude",
    "knowledge-base",
    "reasoning"
  ],
  "author": "Rahul Trikha",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
